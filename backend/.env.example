# RoadSense Backend Environment Configuration Example
# Copy to .env if customizing configuration

# Database Connection URL (defaults to absolute path of roadsense.db in workspace root)
# ROADSENSE_DATABASE_URL=sqlite:///../roadsense.db

# Host and Port configuration
ROADSENSE_HOST=127.0.0.1
ROADSENSE_PORT=8000

# Optional Global Geocoding & Places Provider Keys
# (RoadSense provides an authentic zero-key global fallback using Photon & OpenStreetMap if unset)
# GOOGLE_PLACES_API_KEY=
# MAPBOX_ACCESS_TOKEN=

# Optional OpenStreetMap OSRM Routing URL
# OSRM_ROUTING_URL=https://router.project-osrm.org/route/v1/driving

# Optional external LLM API key (RoadSense assistant runs fully offline & grounded if unset)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
